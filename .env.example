# Server only. Obtain an API Read Access Token from your TMDB account.
TMDB_READ_TOKEN=
# Required in production outside Render. Render supplies RENDER_EXTERNAL_URL.
PUBLIC_BASE_URL=
PORT=3000
# Optional frontend build variable when keeping the UI on GitHub Pages.
# Set the repository variable POSTERFLOW_API_URL to your deployed Render HTTPS URL.
VITE_API_BASE_URL=
